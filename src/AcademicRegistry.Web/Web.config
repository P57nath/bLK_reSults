<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Populated in Phase 4 once BlockchainService.cs exists: Ganache RPC endpoint and the
         deployed AcademicRegistry contract address. Private key storage approach is
         Checkpoint #6 — deliberately not decided yet. -->
    <add key="Blockchain.RpcEndpoint" value="http://127.0.0.1:8545" />
    <add key="Blockchain.ContractAddress" value="" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.3.0.0" newVersion="5.3.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
